# Secrets live in .env.local only (CLAUDE.md hard rule 2). Never commit them.
FAL_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Runtime switches (WP0 §4). Read on every request; flip and ask again.
VOICE=saskia          # native | saskia (saskia is the default as of WP2)
CHAIN=on              # on | off
RENDER=queue          # queue | director (director: not implemented in WP0)
THEATRE=on            # on | off (WP4: console frame vs plain 16:9 player)
MUSIC=on              # on | off (WP5: low music bed under Saskia, default on)

# Dev knob: serve translations from data/translations/ when present.
TRANSLATE_CACHE=on    # on | off

# Where every clip, prompt and expanded_prompt is saved (CLAUDE.md rule 7).
# Relative paths resolve against this checkout's cwd. Default is a folder
# shared by every checkout and worktree (CLAUDE.md rule 8) — leave unset
# unless you deliberately want a checkout's recordings kept separate.
RECORDINGS_DIR=../tessera-recordings
